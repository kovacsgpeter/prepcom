{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "overrides.v1.json",
  "title": "Overrides v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frontmatter": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "base_sha256"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "base_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frontmatter": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "base_sha256"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "base_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
